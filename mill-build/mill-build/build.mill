package build

import mill.*
import mill.meta.MillBuildRootModule

/**
 * Compiles `project/deps/package.mill` as a plain Scala source, so that the meta-build
 * (`mill-build/build.mill`) can reuse the dependencies declared there.
 */
object `package` extends MillBuildRootModule {
  def depsSources: T[Seq[PathRef]] =
    Task.Sources(moduleDir / os.up / os.up / "project" / "deps" / "package.mill")
  override def generatedSources: T[Seq[PathRef]] = Task {
    for (source <- depsSources())
      os.copy(source.path, Task.dest / "deps.scala")
    super.generatedSources() ++ Seq(PathRef(Task.dest))
  }
}
